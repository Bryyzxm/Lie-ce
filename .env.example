# Kredensial Supabase untuk build.
#
# Copy file ini menjadi `.env.local` untuk pengembangan lokal.
# Untuk GitHub Pages, isi nilai yang sama sebagai repository secret
# (Settings -> Secrets and variables -> Actions).
#
# Ambil dari Supabase: Settings -> Data API (URL) dan Settings -> API Keys.
# Boleh anon key legacy (`eyJ...`) atau publishable key (`sb_publishable_...`).
# JANGAN pakai service_role / sb_secret_... : key itu melewati Row Level Security.
#
# Key ini aman dipublikasikan: proteksi data ada di Row Level Security plus
# allowlist tabel `members` (lihat supabase/schema.sql).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
